{
  "entities": {
    "SavedMeal": {
      "title": "SavedMeal",
      "description": "A user-saved meal with full recipe, health insights, and metadata",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "tagline": {
          "type": "string",
          "maxLength": 300
        },
        "cuisine": {
          "type": "string",
          "maxLength": 100
        },
        "spiceLevel": {
          "type": "string",
          "maxLength": 50
        },
        "prepTimeMinutes": {
          "type": "number"
        },
        "cookTimeMinutes": {
          "type": "number"
        },
        "servings": {
          "type": "number"
        },
        "calories": {
          "type": "number"
        },
        "proteinG": {
          "type": "number"
        },
        "carbsG": {
          "type": "number"
        },
        "fatG": {
          "type": "number"
        },
        "healthScore": {
          "type": "number"
        },
        "healthBadge": {
          "type": "string",
          "maxLength": 100
        },
        "healthPros": {
          "type": "array"
        },
        "healthCons": {
          "type": "array"
        },
        "ingredients": {
          "type": "array"
        },
        "instructions": {
          "type": "array"
        },
        "similarMeals": {
          "type": "array"
        },
        "betterAlternatives": {
          "type": "array"
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        },
        "isFavorite": {
          "type": "boolean"
        },
        "hasCooked": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "fullDetail": {
          "type": "object"
        }
      },
      "required": ["id", "userId", "title", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}/savedMeals/{mealId}": {
      "schema": "SavedMeal",
      "description": "User's saved meals and recipes"
    }
  }
}
